# ==============================================================
# Scrap website environment configuration
# Copy this file to .env and fill in your real values on the server.
# NEVER commit a .env file containing real credentials to Git.
# ==============================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scrap_site
DB_USER=scrap_user
DB_PASSWORD=replace-with-a-strong-password

# ---------- Mail ----------
# driver: log | mail | smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.yourhost.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=Your Scrap Company

# ---------- Business contact ----------
ADMIN_EMAIL=info@yourcompany.com
WHATSAPP_NUMBER=966XXXXXXXXX
PHONE_NUMBER=+966XX-XXX-XXXX

# ---------- Session / Security ----------
SESSION_NAME=srap_sess
SESSION_SECURE=0